# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The Anthropic client is constructed with no api_key argument, so the SDK
# resolves credentials from the environment. That is what lets the same code
# run on a key locally and on workload identity federation in deployment --
# see the deployment section of the README.

# --- Decision engine -------------------------------------------------------
# `mock` (default) costs nothing and is what the tests and the demo use.
# `claude` calls the real API.
DECISION_ENGINE=mock

# Required only when DECISION_ENGINE=claude.
# Create a **workspace-scoped** key with a spend limit, not an organisation
# one: the cap is the point, and it keeps this project's cost attributable.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5. Must be a model the pricing table
# knows, otherwise every run records an unknown cost rather than a wrong one.
# CLAUDE_MODEL=claude-opus-5

# --- Engines evaluated on free tiers (specs/004-second-engines) -------------
# For the evaluation runner only, on the development cases; never read by the
# service. Created and kept by the maintainer. Free levels may let the vendor
# train on what it receives: the cases are synthetic, and each run declares
# its data terms (docs/operations.md).
# Google AI Studio key, for gemini-3.8-flash.
# GEMINI_API_KEY=
# The id of the Google project that key belongs to, as AI Studio shows it:
# Gemini's daily quota is the project's (docs/operations.md). Not a secret.
# GEMINI_QUOTA_PROJECT=
# Mistral key, for the two Medium 3.5 configurations (one key, one envelope).
# MISTRAL_API_KEY=

# --- Engines evaluated on prepaid accounts (specs/007-openai-qwen-engines) --
# For the evaluation runner only, on the development cases; never read by the
# service. Created and kept by the maintainer. The organisation and project
# ids are not secrets: they name the account whose envelope a run spends
# (docs/operations.md). Leave OPENAI_CUSTOM_HEADERS and OPENAI_LOG unset: the
# runner refuses to run while either is set.
# OpenAI key, for gpt-6-luna and gpt-6.1-sol.
# OPENAI_API_KEY=
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=
# Scaleway secret key, for qwen3.5-397b-a17b (Generative APIs, Paris).
# SCALEWAY_API_KEY=
# SCALEWAY_ORGANIZATION_ID=
# SCALEWAY_PROJECT_ID=

# --- Claude Haiku 5.5 on the comparison's path (specs/008) ------------------
# The evaluation runner's claude-haiku-5-5 uses ANTHROPIC_API_KEY (above) and
# the organisation id the Anthropic console shows, not a secret. Not
# ANTHROPIC_ORGANIZATION_ID: the SDK reads that name for its own purposes.
# Leave ANTHROPIC_CUSTOM_HEADERS and ANTHROPIC_LOG unset.
# RESOLVE_ANTHROPIC_ORG_ID=

# --- API authentication (ADR-009) -------------------------------------------
# The API is closed by default: a route answers 503 until its kind of caller
# is configured. Use long random values, never a password used elsewhere.
#
# The orchestrator's key. n8n reads the same variable from its own
# environment and sends it as `Authorization: Bearer <key>`.
RESOLVE_SERVICE_KEY=replace-with-a-long-random-value
# Who may approve, as name:secret pairs, comma-separated. A demonstrator's
# sign-in; in production this is the company's identity provider (OIDC).
RESOLVE_APPROVERS=approver@example.test:replace-with-a-long-random-value
# The orchestrator's origin, as the API reaches it. The only address the
# API will call back once a person has decided: n8n's waiting webhook on
# this scheme, host and port, rebuilt here rather than taken from the
# browser (D8). Unset means the API calls nobody back.
RESOLVE_ORCHESTRATOR_URL=http://localhost:5678
# How long a request for approval stays decidable, in hours. Past it the
# action expires and the dispute is to be investigated again (D13).
RESOLVE_APPROVAL_TTL_HOURS=72

# --- Billing platform ---------------------------------------------------------
# `fake` (default) reads fixtures/. `stripe` reads a Stripe account in test
# mode (specs/001-stripe-read-adapter); install the `stripe` extra.
BILLING_PROVIDER=fake

# Required only when BILLING_PROVIDER=stripe. A **restricted** test key
# (rk_test_...), created in the Stripe dashboard with **read** permission on:
# customers, subscriptions, invoices, payment intents, charges and refunds,
# prices, products, billing meters and meter events, test clocks, credit
# notes (a write's status is read through them). To write, **write**
# permission on credit notes, and nothing else. Its
# permissions cannot be read from the key: the dashboard is where they are
# set. A live key, or a standard secret key, is refused.
STRIPE_API_KEY=

# Stripe reads only unless this is exactly `enabled`: then an approved
# correction is made there as a credit note (specs/002-stripe-writes).
# STRIPE_WRITES=enabled

# The seed script's key -- the account's secret **test** key (sk_test_...) --
# never goes here: this file is loaded into the service. It lives in a file
# of its own, `.env.seed` (git-ignored), holding only STRIPE_SEED_KEY and
# loaded for the seed alone: python -m dotenv -f .env.seed run -- ...

# --- Fake billing provider ---------------------------------------------------
# Optional. A directory whose fixture files (customers.json, invoices.json...)
# add entries to fixtures/, for cases kept outside this repository. An id
# already defined is an error; a missing directory too.
# RESOLVE_EXTRA_FIXTURES_DIR=

# --- Persistence -----------------------------------------------------------
# SQLite file holding agent_runs, agent_events and pending_actions.
AUDIT_DB=audit.db
